__pycache__/
*.pyc
.venv/
.pytest_cache/
.hypothesis/
runs/
# data/* rather than data/, or git never descends far enough for the negations below
# to be reachable — an excluded directory cannot have a file re-included out of it.
data/*
# The receptor and the ligand the docking box is centred on: what a run docked
# against has to stay inspectable, the way models/gsk3b_forest.npz does.
!data/structures/
data/structures/*
!data/structures/1M17_receptor.pdbqt
!data/structures/1M17_ligand.sdf
models/*.pkl
.DS_Store
*.egg-info/
build/
dist/

# Generated by `python -m mol_optim.report` from the checkpoints on disk. Regenerable in
# seconds, and a tracked copy goes stale the moment a run changes.
results/report.md

# Kept on disk, deliberately not tracked: the record of what was measured and removed.
docs/held_out_evaluation.md

# The analysis layer, kept on disk and out of the repo: the package produces runs and
# their top-k drawings (results.top_k); turning those into a report is analysis.
mol_optim/report.py
tests/test_report.py

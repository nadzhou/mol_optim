__pycache__/
*.pyc
.venv/
.pytest_cache/
.hypothesis/
runs/
# data/* rather than data/, or git never descends far enough for the negations below
# to be reachable — an excluded directory cannot have a file re-included out of it.
data/*
# The receptor and the ligand the docking box is centred on: what a run docked
# against has to stay inspectable, the way models/gsk3b_forest.npz does.
!data/structures/
data/structures/*
!data/structures/1M17_receptor.pdbqt
!data/structures/1M17_ligand.sdf
models/*.pkl
.DS_Store
*.egg-info/
build/
dist/
